# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) — docker-compose는 host 5434로 매핑(로컬 5432 충돌 회피)
DATABASE_URL=postgres://pacer:pacer@localhost:5434/pacer

# Redis — docker-compose는 host 6381로 매핑(로컬 6379 충돌 회피)
REDIS_URL=redis://localhost:6381

# JWT (마일스톤 3 — 인증에서 사용)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# Social login (마일스톤 3)
KAKAO_REST_API_KEY=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# LLM (마일스톤 2 — 서버 프록시)
LLM_API_KEY=

# 사용량 — 하루 기본 질문 한도 (Phase A는 페이월 미노출, Phase B에서 20 적용)
FREE_DAILY_QUESTION_LIMIT=20

# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) — docker-compose는 host 5434로 매핑(로컬 5432 충돌 회피)
DATABASE_URL=postgres://pacer:pacer@localhost:5434/pacer

# Redis — docker-compose는 host 6381로 매핑(로컬 6379 충돌 회피)
REDIS_URL=redis://localhost:6381

# JWT (마일스톤 3 — 인증에서 사용)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# Social login (마일스톤 3)
KAKAO_REST_API_KEY=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# 관측 (Sentry) — 비우면 비활성. 프로젝트 생성 후 DSN 입력
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# LLM (마일스톤 2 — 서버 프록시)
LLM_API_KEY=

# 사용량 — 하루 기본 질문 한도 (Phase A는 페이월 미노출, Phase B에서 20 적용)
FREE_DAILY_QUESTION_LIMIT=20

# 보안 — CORS 화이트리스트(쉼표 구분, 비우면 CORS 허용 안 함) / rate limit
CORS_ORIGINS=
TRUST_PROXY=false           # Nginx 뒤에 둘 때 true (클라이언트 IP 판별)
THROTTLE_TTL=60             # seconds
THROTTLE_LIMIT=120          # requests per window
THROTTLE_AUTH_LIMIT=10      # /auth/* 는 더 조인다 (크리덴셜 스터핑 방어)

# 개인정보 — 공고 원문·자소서 보관 기간(일). 매일 04:00 KST 파기 배치가 지운다.
SENSITIVE_RETENTION_DAYS=90

# 운영 대시보드(/v1/admin) 접근 토큰. 비우면 대시보드 API가 전부 401.
ADMIN_API_TOKEN=

# 하루 면접 시작 상한 (약관 fair-use, 가격표 비노출)
DAILY_INTERVIEW_LIMIT=5
